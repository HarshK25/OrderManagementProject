# ─────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values
# NEVER commit the actual .env file to Git
# ─────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orderdb
DB_USERNAME=orderuser
DB_PASSWORD=orderpass

# ── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── RabbitMQ ──────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ── JWT ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_use_openssl_rand_base64_64_to_generate_this

# ── Payment Window ────────────────────────────────────────────────
# Minutes before an unpaid order expires (use 1 for testing)
PAYMENT_WINDOW_MINUTES=15

# ── Razorpay (test mode) ──────────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ── Gmail SMTP ────────────────────────────────────────────────────
# Use Gmail App Password (NOT your real password)
# Setup: Gmail → Settings → Security → 2-Step Verification → App passwords
MAIL_USERNAME=your.email@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ── Admin Seed User ───────────────────────────────────────────────
ADMIN_EMAIL=admin@ordermanagement.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=System Admin

# ── CORS ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173
